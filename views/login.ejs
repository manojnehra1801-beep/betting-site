<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Login | BETPAY</title>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,Helvetica,sans-serif;
}

body{
background:#0d1117;
display:flex;
justify-content:center;
align-items:center;
height:100vh;
color:#fff;
}

.login-box{
width:90%;
max-width:400px;
background:#161b22;
padding:30px;
border-radius:18px;
box-shadow:0 0 20px rgba(0,229,255,.15);
}

.logo{
text-align:center;
font-size:32px;
font-weight:bold;
color:#FFD700;
margin-bottom:25px;
}

h2{
text-align:center;
margin-bottom:25px;
}

.input-box{
margin-bottom:18px;
}

.input-box input{
width:100%;
padding:15px;
border:none;
border-radius:10px;
background:#222;
color:#fff;
font-size:16px;
outline:none;
}

.login-btn{
width:100%;
padding:15px;
border:none;
border-radius:10px;
background:#00E5FF;
color:#000;
font-size:18px;
font-weight:bold;
cursor:pointer;
margin-top:10px;
}

.login-btn:hover{
opacity:.9;
}

.links{
margin-top:20px;
text-align:center;
}

.links a{
color:#FFD700;
text-decoration:none;
}

</style>

</head>

<body>

<div class="login-box">

<div class="logo">
🏆 BETPAY
</div>

<h2>Login</h2>

<form action="/login" method="POST">

<div class="input-box">
<input type="email" name="email" placeholder="Email Address" required>
</div>

<div class="input-box">
<input type="password" name="password" placeholder="Password" required>
</div>

<button class="login-btn">
Login
</button>

</form>

<div class="links">
Don't have an account?
<a href="/signup">Sign Up</a>
</div>

</div>

</body>

</html>