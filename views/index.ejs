.sports-section{
padding:20px;
}

.category-title{
font-size:24px;
font-weight:bold;
margin-bottom:15px;
}

.sport-tabs{
display:flex;
overflow:auto;
gap:10px;
margin-bottom:20px;
}

.sport-tabs button{
padding:10px 18px;
border:none;
border-radius:30px;
background:#222;
color:#fff;
font-weight:bold;
white-space:nowrap;
}

.sport-tabs .active{
background:#FFD700;
color:#000;
}

.match-card{
background:#1b1b1b;
padding:18px;
border-radius:16px;
margin-bottom:18px;
}

.league{
color:#FFD700;
margin-bottom:12px;
font-weight:bold;
}

.teams{
display:flex;
justify-content:space-between;
font-size:20px;
margin-bottom:12px;
}

.time{
color:#00ff66;
margin-bottom:15px;
}

.odds{
display:flex;
gap:10px;
}

.odds button{
flex:1;
padding:15px;
background:#111;
border:1px solid #333;
border-radius:12px;
color:#fff;
font-size:16px;
font-weight:bold;
}