<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>BetPay Demo</title>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,Helvetica,sans-serif;
}

body{
background:#0d1117;
color:white;
}

header{
background:#161b22;
padding:18px;
display:flex;
justify-content:space-between;
align-items:center;
position:sticky;
top:0;
}

.logo{
font-size:28px;
font-weight:bold;
color:#FFD700;
}

.balance{
background:#00c853;
padding:10px 16px;
border-radius:25px;
font-weight:bold;
}

.container{
padding:18px;
padding-bottom:90px;
}

.live{
color:#ff3b30;
font-weight:bold;
margin-bottom:12px;
animation:pulse 1s infinite;
}

@keyframes pulse{
50%{
opacity:.4;
}
}

.card{
background:#161b22;
padding:20px;
border-radius:18px;
box-shadow:0 0 20px rgba(0,229,255,.15);
margin-bottom:20px;
}

h2{
text-align:center;
margin-bottom:10px;
}

.status{
text-align:center;
color:#bbb;
margin-bottom:20px;
}

.score{
text-align:center;
font-size:22px;
font-weight:bold;
margin-bottom:20px;
}

.teams{
display:flex;
justify-content:space-between;
margin-bottom:15px;
font-size:22px;
}

.odds{
display:flex;
gap:12px;
}

.bet{
flex:1;
padding:16px;
background:#00E5FF;
border:none;
border-radius:14px;
font-size:20px;
font-weight:bold;
cursor:pointer;
transition:.3s;
}

.bet:hover{
transform:scale(1.03);
}

.section{
font-size:22px;
font-weight:bold;
margin:20px 0 12px;
}

.match{
background:#202833;
padding:18px;
border-radius:15px;
margin-bottom:12px;
line-height:1.8;
}

.notice{
background:#0f5132;
padding:15px;
border-radius:12px;
margin-top:20px;
text-align:center;
font-size:15px;
}

.bottom{
position:fixed;
bottom:0;
left:0;
width:100%;
background:#161b22;
display:flex;
justify-content:space-around;
padding:14px 0;
border-top:1px solid #333;
}

.bottom div{
text-align:center;
font-size:14px;
}

</style>

</head>

<body>

<header>

<div class="logo">
🏆 BETPAY
</div>

<div class="balance">
💰 10,000
</div>

</header>

<div class="container">

<div class="live">
🔴 LIVE MATCH
</div>

<div class="card">

<h2>
🇮🇳 India vs 🏴 England
</h2>

<div class="status">
LIVE • India Batting • 12.4 Overs
</div>

<div class="score">
India 108/2
</div>

<div class="teams">

<div>
🇮🇳 India
</div>

<div>
🏴 England
</div>

</div>

<div class="odds">

<button class="bet">
India
<br>
2.00
</button>

<button class="bet">
England
<br>
5.00
</button>

</div>

</div>

<div class="section">
🔥 More Live Matches
</div>

<div class="match">
🏏 Pakistan vs New Zealand
<br>
Pakistan Odds : <b>1.85</b>
<br>
New Zealand Odds : <b>2.80</b>
</div>

<div class="match">
⚽ Brazil vs Argentina
<br>
Brazil Odds : <b>2.15</b>
<br>
Argentina Odds : <b>1.95</b>
</div>

<div class="match">
🏏 Australia vs South Africa
<br>
Australia Odds : <b>2.40</b>
<br>
South Africa Odds : <b>2.05</b>
</div>

<div class="notice">
🎮 This is a Demo Sports Prediction Site.<br>
Virtual Coins Only • No Real Money.
</div>

</div>

<div class="bottom">

<div>
🏠<br>Home
</div>

<div>
🏏<br>Matches
</div>

<div>
📜<br>History
</div>

<div>
🎁<br>Bonus
</div>

<div>
👤<br>Profile
</div>

</div>

</body>
</html>