<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>BetPay Demo</title>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,Helvetica,sans-serif;
}

body{
background:#0d1117;
color:#fff;
}

header{
position:sticky;
top:0;
display:flex;
justify-content:space-between;
align-items:center;
padding:15px 20px;
background:#161b22;
box-shadow:0 2px 10px rgba(0,0,0,.5);
z-index:999;
}

.logo{
font-size:30px;
font-weight:bold;
color:#FFD700;
}

.auth-buttons{
display:flex;
gap:10px;
}

.auth-buttons a{
text-decoration:none;
padding:10px 18px;
border-radius:25px;
font-weight:bold;
}

.login-btn{
background:#00E5FF;
color:#000;
}

.signup-btn{
background:#FFD700;
color:#000;
}

.banner{
width:100%;
height:220px;
object-fit:cover;
}

.container{
padding:20px;
padding-bottom:100px;
}

.live{
color:#ff4444;
font-weight:bold;
margin-bottom:15px;
animation:pulse 1s infinite;
}

@keyframes pulse{
50%{
opacity:.4;
}
}

.card{
background:#161b22;
padding:18px;
border-radius:16px;
margin-bottom:20px;
box-shadow:0 0 15px rgba(0,229,255,.15);
}

.status{
color:#bbb;
margin:10px 0;
}

.score{
font-size:24px;
font-weight:bold;
margin-bottom:15px;
}

.odds{
display:flex;
gap:10px;
}

.bet{
flex:1;
padding:15px;
background:#00E5FF;
color:#000;
font-size:18px;
font-weight:bold;
border:none;
border-radius:12px;
cursor:pointer;
}

.bet:hover{
transform:scale(1.03);
}
.sports-section{
padding:20px 0;
}

.category-title{
font-size:24px;
font-weight:bold;
margin-bottom:15px;
}

.sport-tabs{
display:flex;
overflow-x:auto;
gap:10px;
margin-bottom:20px;
}

.sport-tabs button{
padding:10px 18px;
border:none;
border-radius:30px;
background:#222;
color:#fff;
font-weight:bold;
white-space:nowrap;
cursor:pointer;
}

.sport-tabs .active{
background:#FFD700;
color:#000;
}

.match-card{
background:#1b1b1b;
padding:18px;
border-radius:16px;
margin-bottom:18px;
}

.league{
color:#FFD700;
font-weight:bold;
margin-bottom:10px;
}

.teams{
display:flex;
justify-content:space-between;
font-size:20px;
margin-bottom:10px;
}

.time{
color:#00ff66;
margin-bottom:15px;
}

.bottom{
position:fixed;
bottom:0;
left:0;
width:100%;
background:#161b22;
display:flex;
justify-content:space-around;
padding:15px 0;
border-top:1px solid #333;
}

.bottom div{
text-align:center;
font-size:14px;
}

</style>

</head>

<body>

<header>

<div class="logo">
🏆 BETPAY
</div>

<div class="auth-buttons">
<a href="/login" class="login-btn">Login</a>
<a href="/signup" class="signup-btn">Sign Up</a>
</div>

</header>

<img class="banner" src="https://images.unsplash.com/photo-1540747913346-19e32dc3e97e?w=1200" alt="Banner">

<div class="container">

<div class="live">
🔴 LIVE MATCH
</div>

<div class="card">

<h2>🇮🇳 India vs 🏴 England</h2>

<div class="status">
LIVE • India Batting • 12.4 Overs
</div>

<div class="score">
India 108/2
</div>

<div class="odds">

<button class="bet">
India<br>2.00
</button>

<button class="bet">
England<br>5.00
</button>

</div>

</div>

<div class="sports-section">

<div class="category-title">
🔥 Live Sports
</div>

<div class="sport-tabs">

<button class="active">Football</button>

<button>Cricket</button>

<button>Tennis</button>

<button>Basketball</button>

<button>Kabaddi</button>

</div>

<div class="match-card">

<div class="league">
UEFA Champions League
</div>

<div class="teams">
<div>FC Barcelona</div>
<div>Manchester City</div>
</div>

<div class="time">
LIVE • 67'
</div>

<div class="odds">

<button class="bet">
Home<br>2.30
</button>

<button class="bet">
Draw<br>3.40
</button>

<button class="bet">
Away<br>2.95
</button>

</div>

</div>

<div class="match-card">

<div class="league">
International Cricket
</div>

<div class="teams">
<div>🇮🇳 India</div>
<div>🏴 England</div>
</div>

<div class="time">
LIVE • 12.4 Overs
</div>

<div class="odds">

<button class="bet">
India<br>2.00
</button>

<button class="bet">
Draw<br>8.50
</button>

<button class="bet">
England<br>5.00
</button>

</div>

</div>

</div>

</div>

<div class="bottom">

<a href="/" class="nav-item">
    <div>🏠</div>
    <div>Home</div>
</a>

<a href="/history" class="nav-item">
    <div>📜</div>
    <div>History</div>
</a>

<a href="/bonus" class="nav-item">
    <div>🎁</div>
    <div>Bonus</div>
</a>

<a href="/profile" class="nav-item">
    <div>👤</div>
    <div>Profile</div>
</a>

</div>

<style>
.bottom{
position:fixed;
left:0;
bottom:0;
width:100%;
height:70px;
background:#161b22;
display:flex;
justify-content:space-around;
align-items:center;
border-top:1px solid #333;
z-index:9999;
}

.nav-item{
flex:1;
height:100%;
display:flex;
flex-direction:column;
justify-content:center;
align-items:center;
text-decoration:none;
color:#fff;
font-size:14px;
font-weight:bold;
}

.nav-item:hover{
color:#FFD700;
background:#202833;
}
</style>