<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>My Profile</title>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,Helvetica,sans-serif;
}

body{
background:#0d1117;
color:white;
}

.header{
background:#161b22;
padding:18px;
text-align:center;
font-size:28px;
font-weight:bold;
color:#FFD700;
}

.container{
padding:20px;
max-width:500px;
margin:auto;
}

.profile-card{
background:#161b22;
padding:25px;
border-radius:18px;
text-align:center;
margin-bottom:20px;
box-shadow:0 0 15px rgba(0,229,255,.15);
}

.avatar{
width:90px;
height:90px;
border-radius:50%;
background:#FFD700;
color:#000;
display:flex;
align-items:center;
justify-content:center;
font-size:40px;
margin:auto;
margin-bottom:15px;
}

.name{
font-size:24px;
font-weight:bold;
}

.username{
color:#00E5FF;
margin-top:5px;
}

.card{
background:#161b22;
padding:18px;
border-radius:15px;
margin-bottom:15px;
}

.title{
font-size:14px;
color:#999;
}

.value{
font-size:18px;
margin-top:5px;
}

button{
width:100%;
padding:15px;
border:none;
border-radius:12px;
margin-top:12px;
font-size:17px;
font-weight:bold;
cursor:pointer;
}

.password{
background:#00E5FF;
color:#000;
}

.history{
background:#FFD700;
color:#000;
}

.logout{
background:#ff3b30;
color:#fff;
}

</style>

</head>

<body>

<div class="header">
👤 My Profile
</div>

<div class="container">

<div class="profile-card">

<div class="avatar">
👤
</div>

<div class="name">
Manoj Kumar
</div>

<div class="username">
@manoj98
</div>

</div>

<div class="card">
<div class="title">Mobile Number</div>
<div class="value">9876543210</div>
</div>

<div class="card">
<div class="title">State</div>
<div class="value">Rajasthan</div>
</div>

<div class="card">
<div class="title">Account Status</div>
<div class="value">🟢 Verified</div>
</div>

<div class="card">
<div class="title">Member Since</div>
<div class="value">July 2026</div>
</div>

<div class="card">
<div class="title">Virtual Coins</div>
<div class="value">10,000</div>
</div>

<div class="card">
<div class="title">Demo Bets Played</div>
<div class="value">0</div>
</div>

<button class="password">
🔒 Update Password
</button>

<button class="history">
📜 Bet History
</button>

<button class="logout">
🚪 Logout
</button>

</div>

</body>
</html>