<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Refer & Earn</title>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,Helvetica,sans-serif;
}

body{
background:#0d1117;
color:#fff;
}

.header{
background:#161b22;
padding:18px;
text-align:center;
font-size:28px;
font-weight:bold;
color:#FFD700;
}

.container{
padding:20px;
max-width:500px;
margin:auto;
}

.card{
background:#161b22;
padding:25px;
border-radius:18px;
margin-bottom:20px;
box-shadow:0 0 15px rgba(0,229,255,.15);
text-align:center;
}

.icon{
font-size:70px;
margin-bottom:15px;
}

.title{
font-size:28px;
font-weight:bold;
color:#FFD700;
margin-bottom:10px;
}

.text{
color:#bbb;
line-height:1.6;
margin-bottom:20px;
}

.reward{
font-size:38px;
font-weight:bold;
color:#00E5FF;
margin-bottom:20px;
}

.code{
background:#0d1117;
padding:15px;
border-radius:10px;
font-size:22px;
font-weight:bold;
letter-spacing:2px;
color:#FFD700;
margin-bottom:20px;
border:1px dashed #FFD700;
}

button{
width:100%;
padding:15px;
border:none;
border-radius:12px;
background:#FFD700;
color:#000;
font-size:18px;
font-weight:bold;
cursor:pointer;
margin-top:10px;
}

button:hover{
opacity:.9;
}

.stats{
background:#161b22;
padding:20px;
border-radius:18px;
}

.row{
display:flex;
justify-content:space-between;
padding:12px 0;
border-bottom:1px solid #333;
font-size:17px;
}

.row:last-child{
border-bottom:none;
}

.home{
display:block;
margin-top:20px;
text-align:center;
padding:15px;
background:#00E5FF;
color:#000;
text-decoration:none;
font-weight:bold;
border-radius:12px;
}

</style>

</head>

<body>

<div class="header">
🎁 Refer & Earn
</div>

<div class="container">

<div class="card">

<div class="icon">
💸
</div>

<div class="title">
Invite Friends
</div>

<div class="text">
Share your referral code with friends.<br>
Earn <b>250 Rs</b> for every successful referral.
</div>

<div class="reward">
+250 Rs / Referral
</div>

<div class="code">
BETPAY250
</div>

<button onclick="copyCode()">
📋 Copy Referral Code
</button>

<button onclick="shareCode()">
📤 Share Referral Code
</button>

</div>

<div class="stats">

<div class="row">
<span>Total Referrals</span>
<span>0</span>
</div>

<div class="row">
<span>Coins Earned</span>
<span>0</span>
</div>

<div class="row">
<span>Reward Per Referral</span>
<span>250 RS</span>
</div>

</div>

<a href="/" class="home">
🏠 Back to Home
</a>

</div>

<script>

function copyCode(){

navigator.clipboard.writeText("BETPAY250");

alert("Referral Code Copied!");

}

function shareCode(){

if(navigator.share){

navigator.share({

title:"BETPAY",

text:"Join BETPAY using my referral code BETPAY250 and earn demo rewards!",

url:window.location.origin

});

}else{

alert("Sharing not supported on this device.");

}

}

</script>

</body>
</html>