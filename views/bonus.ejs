<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Daily Bonus</title>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,Helvetica,sans-serif;
}

body{
background:#0d1117;
color:white;
}

.header{
background:#161b22;
padding:18px;
text-align:center;
font-size:28px;
font-weight:bold;
color:#FFD700;
}

.container{
padding:20px;
max-width:500px;
margin:auto;
}

.card{
background:#161b22;
padding:25px;
border-radius:18px;
text-align:center;
box-shadow:0 0 15px rgba(0,229,255,.15);
margin-bottom:20px;
}

.gift{
font-size:70px;
margin-bottom:15px;
}

.title{
font-size:28px;
font-weight:bold;
color:#FFD700;
}

.text{
margin-top:15px;
color:#ccc;
line-height:1.6;
}

.bonus{
font-size:40px;
font-weight:bold;
color:#00E5FF;
margin:25px 0;
}

button{
width:100%;
padding:16px;
font-size:18px;
font-weight:bold;
background:#FFD700;
color:#000;
border:none;
border-radius:12px;
cursor:pointer;
}

button:hover{
opacity:.9;
}

.reward{
background:#161b22;
padding:18px;
border-radius:15px;
margin-top:20px;
}

.reward h3{
margin-bottom:10px;
color:#FFD700;
}

.reward p{
padding:8px 0;
border-bottom:1px solid #333;
}

</style>

</head>

<body>

<div class="header">
🎁 Daily Bonus
</div>

<div class="container">

<div class="card">

<div class="gift">
🎁
</div>

<div class="title">
Daily Reward
</div>

<div class="text">
Claim your free demo coins once every day.
</div>

<div class="bonus">
+500 Coins
</div>

<button onclick="claimBonus()">
Claim Bonus
</button>

</div>

<div class="reward">

<h3>Reward Schedule</h3>

<p>Day 1 - 500 Coins</p>

<p>Day 2 - 700 Coins</p>

<p>Day 3 - 1000 Coins</p>

<p>Day 4 - 1500 Coins</p>

<p>Day 5 - 2000 Coins</p>

<p>Day 6 - 3000 Coins</p>

<p>Day 7 - 5000 Coins</p>

</div>

</div>

<script>

function claimBonus(){

alert("🎉 Congratulations!\n\n500 Demo Coins Added.");

}

</script>

</body>

</html>