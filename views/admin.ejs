<div class="main">

<h1>🏏 Manage Matches</h1>

<br>

<div class="card">

<h3>Add New Match</h3>

<br>

<form action="/admin/add-match" method="POST">

<input type="text" name="team1" placeholder="Team 1" required>

<br><br>

<input type="text" name="team2" placeholder="Team 2" required>

<br><br>

<input type="number" step="0.01" name="odds1" placeholder="Team 1 Odds" required>

<br><br>

<input type="number" step="0.01" name="odds2" placeholder="Team 2 Odds" required>

<br><br>

<select name="status">

<option>Upcoming</option>

<option selected>Live</option>

<option>Finished</option>

</select>

<br><br>

<button type="submit">
Add Match
</button>

</form>

</div>

<br>

<div class="card">

<h3>Current Matches</h3>

<table width="100%" cellspacing="0">

<tr>
<th>Match</th>
<th>Odds</th>
<th>Status</th>
<th>Action</th>
</tr>

