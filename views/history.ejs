<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Bet History</title>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,Helvetica,sans-serif;
}

body{
background:#0d1117;
color:white;
}

.header{
background:#161b22;
padding:18px;
text-align:center;
font-size:28px;
font-weight:bold;
color:#FFD700;
}

.container{
padding:20px;
max-width:600px;
margin:auto;
}

.summary{
display:flex;
justify-content:space-between;
margin-bottom:20px;
gap:10px;
}

.box{
flex:1;
background:#161b22;
padding:18px;
border-radius:15px;
text-align:center;
}

.box h3{
color:#FFD700;
margin-bottom:10px;
}

.box p{
font-size:22px;
font-weight:bold;
}

.card{
background:#161b22;
padding:18px;
border-radius:15px;
margin-bottom:15px;
box-shadow:0 0 10px rgba(0,229,255,.1);
}

.match{
font-size:20px;
font-weight:bold;
margin-bottom:10px;
}

.details{
color:#bbb;
margin-bottom:8px;
}

.win{
color:#00E676;
font-weight:bold;
}

.loss{
color:#FF5252;
font-weight:bold;
}

.pending{
color:#FFD700;
font-weight:bold;
}

.empty{
text-align:center;
margin-top:50px;
color:#888;
font-size:18px;
}

.home-btn{
display:block;
text-align:center;
margin-top:25px;
padding:15px;
background:#FFD700;
color:#000;
text-decoration:none;
border-radius:12px;
font-weight:bold;
}

</style>

</head>

<body>

<div class="header">
📜 Bet History
</div>

<div class="container">

<div class="summary">

<div class="box">
<h3>Total Bets</h3>
<p>0</p>
</div>

<div class="box">
<h3>Wins</h3>
<p>0</p>
</div>

<div class="box">
<h3>Losses</h3>
<p>0</p>
</div>

</div>

<div class="card">

<div class="match">
🇮🇳 India vs 🏴 England
</div>

<div class="details">
Bet: India @ 2.00
</div>

<div class="details">
Amount: 500 Coins
</div>

<div class="pending">
Status: Pending
</div>

</div>

<div class="card">

<div class="match">
⚽ Barcelona vs Manchester City
</div>

<div class="details">
Bet: Barcelona @ 2.30
</div>

<div class="details">
Amount: 1000 Coins
</div>

<div class="win">
Status: Won (+2300 Coins)
</div>

</div>

<div class="card">

<div class="match">
🏏 Pakistan vs New Zealand
</div>

<div class="details">
Bet: Pakistan @ 1.85
</div>

<div class="details">
Amount: 800 Coins
</div>

<div class="loss">
Status: Lost
</div>

</div>

<div class="empty">
More betting history will appear here.
</div>

<a href="/" class="home-btn">
🏠 Back to Home
</a>

</div>

</body>
</html>